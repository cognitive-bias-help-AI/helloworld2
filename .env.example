# ============================================================
# Investment Review — Local Environment Template
#
# Copy this file to `.env`.
# `.env` contains secrets and MUST NOT be committed.
# ============================================================

# ────────────────────────────────────────────────────────────
# Application Runtime
# ────────────────────────────────────────────────────────────
APP_ENV=development
TIMEZONE=Asia/Seoul
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review

# ────────────────────────────────────────────────────────────
# LLM Backend
#
# mlapi      → GPT-5.6 Luna / Terra / Sol
# anthropic  → existing Claude backend
# ────────────────────────────────────────────────────────────
MODEL_BACKEND=mlapi

# ── SMALL — GPT-5.6 Luna ───────────────────────────────────
# Used by: n1, intake_review / n3/v2, n7
# n4 is not a standalone runtime vertex and has no configuration.
LUNA_API_URL=
LUNA_API_KEY=

# ── MID — GPT-5.6 Terra ────────────────────────────────────
# Used by: n11
TERRA_API_URL=
TERRA_API_KEY=

# ── LARGE — GPT-5.6 Sol ────────────────────────────────────
# Used by: n8, n9, n10
SOL_API_URL=
SOL_API_KEY=

# ── Optional Anthropic Backend ──────────────────────────────
# Required only when MODEL_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# ────────────────────────────────────────────────────────────
# DART / Disclosure & Financial Evidence
# ────────────────────────────────────────────────────────────
DART_API_KEY=
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/review
# PostgreSQL integration tests only; use an isolated disposable test database.
TEST_POSTGRES_DSN=

# ────────────────────────────────────────────────────────────
# Kiwoom / Market Data
# ────────────────────────────────────────────────────────────
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# ────────────────────────────────────────────────────────────
# KRX / Stock Master
# ────────────────────────────────────────────────────────────
KRX_API_KEY=

# ────────────────────────────────────────────────────────────
# Naver / News
# ────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────
# Optional Operations / Notification
# ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ────────────────────────────────────────────────────────────
# Replay Cache
# ────────────────────────────────────────────────────────────
# off: live calls; record: live calls plus fixtures; replay: fixtures only.
REPLAY_MODE=replay
# Local server-side diagnostics only. Never expose this as NEXT_PUBLIC_*.
REVIEW_DEBUG_LOGS=0
