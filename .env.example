# 복사해서 .env 로 쓴다. .env 는 커밋 금지이고 Claude Code 도 읽지 못한다
# (.claude/settings.json 의 permissions.deny 가 막는다).

# ── Runtime bootstrap ────────────────────────────────────
APP_ENV=development
TIMEZONE=Asia/Seoul
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review

# ── 모델 (팀원3) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 공시 라인 (팀원2) ────────────────────────────────────
DART_API_KEY=
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/review
# PostgreSQL integration tests only. Must target an isolated disposable test database.
TEST_POSTGRES_DSN=

# ── 시세·종목 라인 (팀원1) ───────────────────────────────
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KRX_API_KEY=
SLACK_WEBHOOK_URL=

# ── 뉴스 (팀원3) ─────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 재생 캐시 (D-21) ─────────────────────────────────────
# off    캐시 안 씀. 항상 실호출
# record 실호출하고 응답을 fixture 로 저장
# replay fixture 만 읽는다. 없으면 KeyError — 비용 0 회귀의 기반
REPLAY_MODE=replay
